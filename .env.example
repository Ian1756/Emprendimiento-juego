# Copia este archivo como .env.local y llena los valores.
# NUNCA subas .env.local al repositorio (INSTRUCCIONES.md §4.4).

# --- Secretos del servidor (jamás con prefijo NEXT_PUBLIC_) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional. Si está vacío se usa el almacén en archivo (.data/db.json), útil en
# desarrollo y en un evento con un solo servidor.
DATABASE_URL=

# Ruta del almacén en archivo cuando no hay DATABASE_URL.
DATA_FILE=.data/db.json

# Solo si /api/health reporta un problema de certificado TLS con la base.
# Mantiene el tráfico cifrado pero deja de verificar la identidad del servidor.
# DATABASE_SSL_MODE=no-verify

# Host que sirve el tablero en vivo en vez del juego (§2.7). Sin https:// ni
# barra final. Vacío = el tablero solo vive en la ruta /tablero.
LEADERBOARD_HOST=

# --- Configuración pública (llega al navegador, no debe ser secreta) ---
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/PENDIENTE-DE-CONFIGURAR
NEXT_PUBLIC_PRIVACY_URL=/aviso-de-privacidad
NEXT_PUBLIC_CONTACT_URL=https://tec.mx/es/emprendimiento
NEXT_PUBLIC_ORG_NAME=Emprendimiento Tec CEM
